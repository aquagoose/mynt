<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="piko.VulkanMemoryAllocator.Silk.NET" Version="0.0.6" />
        <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
        <None Include="libvulkan.dylib" CopyToOutputDirectory="PreserveNewest" />
        <None Include="libMoltenVK.dylib" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
